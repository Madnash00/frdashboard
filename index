
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fiorella Rubino | Dashboard Unificata v2.20</title>
<style>
:root{--ink:#172a46;--muted:#68778b;--line:#dce5ef;--panel:#fff;--soft:#f5f8fc;--accent:#2450a6;--accent2:#356bc4;--good:#0f9f6e;--bad:#dc2626;--warn:#b7791f;--shadow:0 12px 30px rgba(21,42,70,.08)}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#eef3f9;overflow:hidden}
button,select,input{font:inherit;touch-action:manipulation}
button{cursor:pointer}
.shell{height:100%;display:grid;grid-template-rows:auto auto minmax(0,1fr)}
.shell-header{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:11px clamp(16px,3vw,38px);background:#ffcbc9;color:#000;border-bottom:1px solid var(--line);box-shadow:0 4px 16px rgba(21,42,70,.055);z-index:20}
.shell-title{min-width:0}
.shell-title h1{font-size:clamp(17px,2vw,23px);line-height:1.1;margin:0;font-weight:900;letter-spacing:-.025em;color:#000}
.shell-title p{margin:5px 0 0;color:#000;font-size:11px;font-weight:400;letter-spacing:.035em}
.brand{display:flex;flex-direction:column;align-items:flex-end;flex:0 0 auto}
.brand img{display:block;width:172px;max-width:32vw;height:auto}
.brand span{margin-top:4px;color:#000;font-size:10px;font-weight:400;letter-spacing:.04em}
.macro-nav{display:flex;gap:8px;padding:8px clamp(16px,3vw,38px);background:#f8fbff;border-bottom:1px solid var(--line);z-index:15}
.macro-tab{min-width:150px;border:1px solid #cbd8e8;background:#fff;color:#52657e;padding:9px 18px;border-radius:11px;font-size:12px;font-weight:900;letter-spacing:.055em;transition:.16s ease}
.macro-tab:hover{border-color:#8aa8cf;color:var(--accent)}
.macro-tab.active{color:#fff;border-color:var(--accent);background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 7px 16px rgba(36,80,166,.18)}
.store-visit-export{margin-left:auto;border:1px solid #2450a6;background:#fff;color:#2450a6;padding:9px 18px;border-radius:11px;font-size:12px;font-weight:900;letter-spacing:.035em;white-space:nowrap;transition:.16s ease}
.store-visit-export:hover{background:#eef5ff;border-color:#173f88}.store-visit-export:disabled{opacity:.62;cursor:wait}
.shell-main{position:relative;min-height:0}
.macro-page{position:absolute;inset:0;display:none;min-height:0}
.macro-page.active{display:block}
.upload-page{overflow:auto;padding:clamp(18px,3vw,34px) clamp(16px,4vw,52px) 42px;background:linear-gradient(180deg,#f5f8fc,#edf3f9)}
.upload-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;max-width:1460px;margin:0 auto 18px}
.upload-head h2{margin:0;font-size:clamp(21px,2.4vw,30px);letter-spacing:-.035em}
.upload-head p{margin:7px 0 0;color:var(--muted);font-size:13px;line-height:1.45}
.source-pills{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.source-pill{white-space:nowrap;border:1px solid #d4deeb;background:#fff;border-radius:999px;padding:6px 9px;color:#60718a;font-size:10px;font-weight:800}
.upload-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;max-width:1460px;margin:0 auto}
.upload-card{position:relative;display:flex;flex-direction:column;min-height:186px;border:1px dashed #b9c9dc;border-radius:17px;background:rgba(255,255,255,.96);box-shadow:var(--shadow);padding:16px;transition:border-color .18s,transform .18s,box-shadow .18s}
.upload-card.dragover{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 0 0 4px rgba(36,80,166,.10),var(--shadow)}
.upload-card.shared{border-style:solid;border-color:#9cc2ef;background:linear-gradient(145deg,#fff,#f2f7ff)}
.upload-card.loading::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(100deg,transparent,rgba(36,80,166,.055),transparent);animation:sweep 1.25s linear infinite}
@keyframes sweep{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px}
.card-title{font-size:14px;font-weight:950;letter-spacing:.015em}
.card-badge{border-radius:999px;background:#eaf0f8;color:#60718a;padding:4px 7px;font-size:9px;font-weight:900;letter-spacing:.06em}
.shared .card-badge{background:#dcecff;color:#2450a6}
.drive-select{width:100%;min-width:0;height:36px;border:1px solid #cbd8e8;border-radius:10px;background:#fff;color:#334b68;padding:0 10px;font-size:11px;font-weight:700;outline:none;text-overflow:ellipsis}
.drive-select:focus{border-color:#6d94c7;box-shadow:0 0 0 3px rgba(36,80,166,.10)}
.file-action{display:block;margin-top:9px;border:1px solid #cbd8e8;border-radius:10px;background:#fff;color:var(--ink);padding:9px 10px;text-align:center;font-size:11px;font-weight:900;transition:.15s ease}
.file-action:hover{border-color:#8aa8cf;background:#f8fbff;color:var(--accent)}
.file-input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.card-status{margin-top:auto;padding-top:12px;min-height:31px;color:var(--muted);font-size:10px;font-weight:700;line-height:1.35;overflow-wrap:anywhere}
.card-status.ok{color:var(--good)}
.card-status.bad{color:var(--bad)}
.card-status.loading{color:var(--accent)}
.shared-note{display:block;margin-top:3px;color:#7290b5;font-size:9px;font-weight:750}
.frame-page{background:#eef3f9;overflow:hidden}
.dashboard-frame{display:block;width:100%;height:100%;border:0;background:#eef3f9}
.frame-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:11px;color:#60718a;font-size:12px;font-weight:800;background:#f4f7fb;z-index:2}
.frame-loading.hidden{display:none}
.spinner{width:26px;height:26px;border:3px solid #dce5ef;border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.modal-overlay{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(17,31,49,.48);backdrop-filter:blur(3px);z-index:1000}
.modal-overlay.open{display:flex}
.modal{width:min(470px,100%);border:1px solid #d7e1ee;border-radius:18px;background:#fff;box-shadow:0 24px 70px rgba(15,31,52,.24);padding:22px}
.modal h3{margin:0;font-size:19px}
.modal-sub{margin:7px 0 17px;color:var(--muted);font-size:12px;line-height:1.45}
.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.modal-field.hidden{display:none}
.modal label{display:block;margin:0 0 6px;color:#52657e;font-size:11px;font-weight:850}
.modal input,.modal select{width:100%;height:39px;border:1px solid #cbd8e8;border-radius:10px;padding:0 10px;background:#fff;color:var(--ink)}
.modal-preview{margin-top:12px;border:1px solid #dce6f1;border-radius:10px;background:#f7faff;padding:10px;color:var(--accent);font-size:12px;font-weight:850;overflow-wrap:anywhere}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
.modal-actions button{border:1px solid #cbd8e8;border-radius:10px;padding:9px 13px;background:#fff;color:var(--ink);font-size:11px;font-weight:900}
.modal-actions .primary{border-color:var(--accent);background:var(--accent);color:#fff}
@media(max-width:1050px){.upload-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){body{overflow:auto} .store-visit-export{margin-left:0}.shell{min-height:100%;height:auto;grid-template-rows:auto auto minmax(680px,1fr)}.shell-header{align-items:flex-start}.brand img{width:125px}.macro-nav{overflow-x:auto}.macro-tab{min-width:135px}.upload-head{align-items:flex-start;flex-direction:column}.source-pills{justify-content:flex-start}.upload-grid{grid-template-columns:1fr}.modal-grid{grid-template-columns:1fr}.upload-page{padding-bottom:28px}}
</style>
</head>
<body>
<div class="shell">
  <header class="shell-header">
    <div class="shell-title"><h1>DM Dashboard Retail</h1><p>PERFORMANCE E STOCK IN UN UNICO AMBIENTE</p></div>
    <div class="brand"><img src="data:image/png;base64," alt="Fiorella Rubino"><span>Dashboard Unificata v2.20</span></div>
  </header>
  <nav class="macro-nav" aria-label="Macro-pagine">
    <button class="macro-tab active" type="button" data-macro="uploads" aria-selected="true">FILES UPLOAD</button>
    <button class="macro-tab" type="button" data-macro="performance" aria-selected="false">PERFORMANCE</button>
    <button class="macro-tab" type="button" data-macro="stock" aria-selected="false">STOCK</button>
    <button class="store-visit-export" id="createStoreVisitDashboard" type="button">Crea STORE VISIT DASHBOARD</button>
  </nav>
  <main class="shell-main">
    <section class="macro-page upload-page active" id="macro-uploads" aria-label="Files Upload">
      <div class="upload-head">
        <div><h2>Files Upload</h2><p>Tutti i file delle due dashboard in un’unica area. Il DBINFO è condiviso e aggiorna sia PERFORMANCE sia STOCK.</p></div>
      </div>
      <div class="upload-grid" id="unifiedUploadGrid"></div>
    </section>
    <section class="macro-page frame-page" id="macro-performance" aria-label="Performance">
      <div class="frame-loading" id="performanceLoading"><div class="spinner"></div><span>Caricamento PERFORMANCE…</span></div>
      <iframe class="dashboard-frame" id="performanceFrame" title="Dashboard Performance DMSINTESI"></iframe>
    </section>
    <section class="macro-page frame-page" id="macro-stock" aria-label="Stock">
      <div class="frame-loading" id="stockLoading"><div class="spinner"></div><span>Caricamento STOCK…</span></div>
      <iframe class="dashboard-frame" id="stockFrame" title="Dashboard Stock GIACENZE"></iframe>
    </section>
  </main>
</div>

<div class="modal-overlay" id="namingModal" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <h3 id="modalTitle">Salvataggio file su Drive</h3>
    <div class="modal-sub" id="modalSubtitle">Seleziona la data per generare il nome del file.</div>
    <div class="modal-grid">
      <div class="modal-field"><label for="modalDate">Data</label><input id="modalDate" type="date"></div>
      <div class="modal-field" id="modalSeasonField"><label for="modalSeason">Stagione</label><select id="modalSeason"><option value="PE">PE</option><option value="AI">AI</option></select></div>
    </div>
    <label style="margin-top:12px">Nome file generato</label>
    <div class="modal-preview" id="modalPreview">-</div>
    <div class="modal-actions"><button type="button" id="modalCancel">Annulla</button><button type="button" class="primary" id="modalConfirm">Conferma e carica</button></div>
  </div>
</div>

<div class="modal-overlay" id="overwriteModal" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="overwriteModalTitle">
    <h3 id="overwriteModalTitle">Giorno già presente sul database? Sovrascrivo?</h3>
    <div class="modal-actions"><button type="button" id="overwriteCancel">ANNULLA</button><button type="button" class="primary" id="overwriteProceed">PROCEDI</button></div>
  </div>
</div>

<script>
(function(){
'use strict';
var VERSION='v2.20';
var STARTUP_LOAD_ORDER=['DBINFO','DMSINTESI','DMSINTESI_PIAZZE','VENDACAP','FIDELIZZAZIONE','GIACENZA'];
window.__UNIFIED_STARTUP_MANAGED__=true;
var EMBEDDED_SOURCES={performance:'',stock:''};
var frameState={performance:{ready:false,promise:null},stock:{ready:false,promise:null}};
var sharedDbSnapshot={rows:null,fileName:'',revision:0,appliedRevision:0,promise:null};
var statusObservers=[];
var configList=[
  {id:'dmsintesi',title:'DMSINTESI',badge:'PERFORMANCE',frame:'performance',destination:'DMSINTESI',selectId:'driveFileSelect',statusId:'dropStatus',handler:'handleFile',setter:'setStatus',accept:'.xlsx,.xls,.xlsm'},
  {id:'piazze',title:'DMSINTESI PIAZZE',badge:'PERFORMANCE',frame:'performance',destination:'DMSINTESI_PIAZZE',selectId:'piazzaDriveFileSelect',statusId:'piazzaDropStatus',handler:'handlePiazzaFile',setter:'piazzaSetStatus',accept:'.xlsx,.xlsm'},
  {id:'vendacap',title:'VENDACAP',badge:'PERFORMANCE',frame:'performance',destination:'VENDACAP',selectId:'vendacapDriveFileSelect',statusId:'vendacapDropStatus',handler:'handleVendacapFile',setter:'setVendStatus',accept:'.xlsx,.xls,.xlsm'},
  {id:'fidelizzazione',title:'FIDELIZZAZIONE',badge:'PERFORMANCE',frame:'performance',destination:'FIDELIZZAZIONE',selectId:'loyaltyDriveFileSelect',statusId:'loyaltyDropStatus',handler:'handleLoyaltyFile',setter:'setLoyaltyStatus',accept:'.xlsx,.xls,.xlsm'},
  {id:'giacenza',title:'GIACENZA',badge:'STOCK',frame:'stock',destination:'GIACENZA',selectId:'stockDriveSelect',statusId:'stockStatus',handler:'handleStock',setter:'setStatus',accept:'.xlsx,.xls,.xlsm'},
  {id:'dbinfo',title:'DBINFO',badge:'CONDIVISO',frame:'performance',destination:'DBINFO',selectId:'dbDriveFileSelect',statusId:'dbDropStatus',handler:'handleDbFile',setter:'setDbStatus',accept:'.xlsx,.xls,.xlsm',shared:true}
];
var configs={};configList.forEach(function(c){configs[c.id]=c;});

var elementCache=new Map();
function el(id){var cached=elementCache.get(id);if(cached&&cached.isConnected)return cached;var node=document.getElementById(id);if(node)elementCache.set(id,node);return node;}
function delay(ms){return new Promise(function(resolve){setTimeout(resolve,ms);});}
function timeout(promise,ms,label){return new Promise(function(resolve,reject){var timer=setTimeout(function(){reject(new Error(label||'Operazione scaduta'));},ms);Promise.resolve(promise).then(function(value){clearTimeout(timer);resolve(value);},function(err){clearTimeout(timer);reject(err);});});}
function requestIdle(fn,wait){if('requestIdleCallback' in window)requestIdleCallback(fn,{timeout:wait||2200});else setTimeout(fn,wait||250);}
function escapeHtml(v){return String(v==null?'':v).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];});}

async function inflateGzip(base64){
  if(typeof DecompressionStream!=='function')throw new Error('Il browser deve supportare DecompressionStream. Usa una versione aggiornata di Chrome o Edge.');
  var binary=atob(base64),bytes=new Uint8Array(binary.length);
  for(var i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);
  var stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
  return new Response(stream).text();
}

async function ensureFrame(name){
  var state=frameState[name];
  if(state.ready)return el(name+'Frame');
  if(state.promise)return state.promise;
  state.promise=(async function(){
    var frame=el(name+'Frame'),loading=el(name+'Loading');
    try{
      var html=await inflateGzip(EMBEDDED_SOURCES[name]);
      await timeout(new Promise(function(resolve,reject){
        var settled=false;
        frame.onload=function(){if(!settled){settled=true;resolve();}};
        frame.onerror=function(){if(!settled){settled=true;reject(new Error('Caricamento non riuscito'));}};
        frame.srcdoc=html;
      }),45000,'Timeout caricamento '+name.toUpperCase());
      state.ready=true;
      if(loading)loading.classList.add('hidden');
      wireFrame(name);
      return frame;
    }catch(err){
      if(loading){loading.innerHTML='<strong>Dashboard non inizializzata</strong><span>'+escapeHtml(err.message||err)+'</span>';}
      throw err;
    }
  })();
  return state.promise;
}

async function waitForApi(frameName,property,ms){
  var frame=await ensureFrame(frameName),started=Date.now();
  while(Date.now()-started<(ms||30000)){
    var win=frame.contentWindow;
    var api=frameName==='performance'?win.__UNIFIED_DMS_API:win.__UNIFIED_STOCK_API;
    if(api&&(!property||typeof api[property]==='function'))return api;
    await delay(60);
  }
  throw new Error('Modulo '+frameName.toUpperCase()+' non pronto: '+property);
}

async function waitForChildElement(frameName,id,ms){
  var frame=await ensureFrame(frameName),started=Date.now();
  while(Date.now()-started<(ms||30000)){
    var node=frame.contentDocument&&frame.contentDocument.getElementById(id);
    if(node)return node;
    await delay(80);
  }
  throw new Error('Controllo non disponibile: '+id);
}

function renderCards(){
  el('unifiedUploadGrid').innerHTML=configList.map(function(c){
    var note=c.shared?'<span class="shared-note">Un solo file per PERFORMANCE e STOCK</span>':'';
    return '<article class="upload-card'+(c.shared?' shared':'')+'" id="card-'+c.id+'" data-upload="'+c.id+'">'+
      '<div class="card-top"><div><div class="card-title">'+escapeHtml(c.title)+'</div>'+note+'</div><span class="card-badge">'+escapeHtml(c.badge)+'</span></div>'+
      '<select class="drive-select" id="select-'+c.id+'" aria-label="Seleziona '+escapeHtml(c.title)+' da Drive"><option value="">Drive: inizializzazione…</option></select>'+
      '<label class="file-action" for="input-'+c.id+'">Carica/Seleziona '+escapeHtml(c.title)+'</label>'+
      '<input class="file-input" id="input-'+c.id+'" type="file" accept="'+c.accept+'">'+
      '<div class="card-status loading" id="status-'+c.id+'">Inizializzazione dashboard…</div></article>';
  }).join('');

  configList.forEach(function(c){
    var card=el('card-'+c.id),input=el('input-'+c.id),select=el('select-'+c.id);
    input.addEventListener('change',function(){var file=input.files&&input.files[0];if(file)handleLocal(c,file).finally(function(){input.value='';});});
    ['dragenter','dragover'].forEach(function(type){card.addEventListener(type,function(e){e.preventDefault();e.stopPropagation();card.classList.add('dragover');});});
    ['dragleave','drop'].forEach(function(type){card.addEventListener(type,function(e){e.preventDefault();e.stopPropagation();card.classList.remove('dragover');});});
    card.addEventListener('drop',function(e){var file=e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files[0];if(file)handleLocal(c,file);});
    var warmed=false;
    function warm(){if(warmed&&select.options.length>1)return;warmed=true;refreshDrive(c,true).catch(function(err){setCardStatus(c,err.message||err,'bad');});}
    select.addEventListener('focus',warm);
    select.addEventListener('pointerdown',warm,{passive:true});
    select.addEventListener('change',function(){if(select.value)handleDriveChoice(c,select.value);});
  });
}

function setCardStatus(c,message,mode){
  var status=el('status-'+c.id),card=el('card-'+c.id);if(!status||!card)return;
  status.textContent=String(message||'');
  status.classList.remove('ok','bad','loading');
  card.classList.remove('loading');
  if(mode)status.classList.add(mode);
  if(mode==='loading')card.classList.add('loading');
}

function statusMode(node){if(!node)return '';if(node.classList.contains('bad'))return 'bad';if(node.classList.contains('ok'))return 'ok';if(node.classList.contains('loading'))return 'loading';return '';}

async function syncStatus(c){
  try{
    var node=await waitForChildElement(c.frame,c.statusId,30000);
    setCardStatus(c,node.textContent,statusMode(node));
  }catch(_){ }
}

async function syncSelect(c){
  try{
    var child=await waitForChildElement(c.frame,c.selectId,30000),parent=el('select-'+c.id);
    var previous=parent.value,childValue=child.value,fragment=document.createDocumentFragment();
    Array.from(child.options).forEach(function(option){var clone=document.createElement('option');clone.value=option.value;clone.textContent=option.textContent;fragment.appendChild(clone);});
    parent.innerHTML='';parent.appendChild(fragment);
    var values=Array.from(parent.options).map(function(o){return o.value;});
    if(childValue&&values.indexOf(childValue)>=0)parent.value=childValue;
    else if(previous&&values.indexOf(previous)>=0)parent.value=previous;
    else if(parent.options.length>1)parent.selectedIndex=1;
  }catch(_){ }
}

async function observeConfig(c){
  try{
    var status=await waitForChildElement(c.frame,c.statusId,35000),select=await waitForChildElement(c.frame,c.selectId,35000);
    var statusObserver=new MutationObserver(function(){syncStatus(c);});
    statusObserver.observe(status,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class']});
    var selectObserver=new MutationObserver(function(){syncSelect(c);});
    selectObserver.observe(select,{subtree:true,childList:true,attributes:true});
    statusObservers.push(statusObserver,selectObserver);
    syncStatus(c);syncSelect(c);
  }catch(err){setCardStatus(c,'Controllo non disponibile: '+(err.message||err),'bad');}
}

function cloneSharedDbRows(rows){try{return JSON.parse(JSON.stringify(rows||[]));}catch(_){return Array.from(rows||[],function(row){return Object.assign({},row);});}}
async function flushSharedDbInfoToStock(){
  if(!sharedDbSnapshot.rows||!sharedDbSnapshot.rows.length)return null;
  if(sharedDbSnapshot.promise)return sharedDbSnapshot.promise;
  var revision=sharedDbSnapshot.revision;
  sharedDbSnapshot.promise=(async function(){
    var api=await waitForApi('stock','applySharedDbRows',45000);
    var result=await api.applySharedDbRows(cloneSharedDbRows(sharedDbSnapshot.rows),sharedDbSnapshot.fileName||'DBINFO condiviso');
    sharedDbSnapshot.appliedRevision=Math.max(sharedDbSnapshot.appliedRevision,revision);
    return result;
  })();
  try{return await sharedDbSnapshot.promise;}
  finally{
    sharedDbSnapshot.promise=null;
    if(sharedDbSnapshot.revision>sharedDbSnapshot.appliedRevision)setTimeout(function(){flushSharedDbInfoToStock().catch(function(err){console.warn('Sincronizzazione DBINFO verso STOCK non riuscita',err);});},0);
  }
}
window.__UNIFIED_PUSH_DBINFO_ROWS=function(rows,fileName){
  if(!Array.isArray(rows)||!rows.length)return Promise.resolve(null);
  sharedDbSnapshot.rows=cloneSharedDbRows(rows);
  sharedDbSnapshot.fileName=String(fileName||'DBINFO condiviso');
  sharedDbSnapshot.revision++;
  if(frameState.stock.ready)return flushSharedDbInfoToStock().catch(function(err){console.warn('Sincronizzazione DBINFO verso STOCK non riuscita',err);return null;});
  return Promise.resolve(null);
};
function wireFrame(name){configList.filter(function(c){return c.frame===name;}).forEach(observeConfig);if(name==='stock')flushSharedDbInfoToStock().catch(function(err){console.warn('Applicazione DBINFO condiviso differita',err);});}

async function handleLocal(c,file){
  setCardStatus(c,c.title+': analisi file in corso…','loading');
  try{
    if(c.shared){
      var api=await waitForApi('performance','handleDbFile');
      await api.handleDbFile(file,{});
      await flushSharedDbInfoToStock();
      await syncStatus(c);
      await syncSelect(c);
      var current=el('status-'+c.id).textContent;
      if(!/stock/i.test(current))setCardStatus(c,current+' · STOCK sincronizzato',el('status-'+c.id).classList.contains('bad')?'bad':'ok');
      return;
    }
    if(c.frame==='stock'){
      var stockApi=await waitForApi('stock','handleLocalUploadFile');
      await stockApi.handleLocalUploadFile(file,stockApi.handleStock,{rename:true});
    }else{
      var api=await waitForApi('performance',c.handler);
      await api[c.handler](file,{});
    }
    await syncStatus(c);
    await syncSelect(c);
  }catch(err){console.error(err);setCardStatus(c,c.title+': '+(err.message||err),'bad');}
}

async function refreshDrive(c,force){
  setCardStatus(c,c.title+': aggiornamento elenco Drive…','loading');
  try{
    if(c.frame==='stock'){
      var stockApi=await waitForApi('stock','refreshDriveList');
      await stockApi.refreshDriveList('GIACENZA',c.selectId,c.statusId,{force:!!force});
    }else{
      var api=await waitForApi('performance','refreshDriveFileList');
      var setter=api[c.setter]||function(){};
      await api.refreshDriveFileList(c.destination,c.selectId,setter,{force:!!force});
    }
    await syncSelect(c);await syncStatus(c);
  }catch(err){setCardStatus(c,c.title+': elenco Drive non disponibile · '+(err.message||err),'bad');throw err;}
}

async function handleDriveChoice(c,fileId){
  setCardStatus(c,c.title+': caricamento da Drive…','loading');
  try{
    var childSelect=await waitForChildElement(c.frame,c.selectId,30000);childSelect.value=fileId;
    if(c.shared){
      var api=await waitForApi('performance','loadDriveSelectedFile');
      await api.loadDriveSelectedFile('DBINFO',c.selectId,function(file,opts){
        return api.handleDbFile(file,Object.assign({},opts,{skipDriveUpload:true,fromDrive:true}));
      },api.setDbStatus,{force:true});
      await flushSharedDbInfoToStock();
      await syncStatus(c);
      var dbText=el('status-'+c.id).textContent;
      if(!/stock/i.test(dbText))setCardStatus(c,dbText+' · STOCK sincronizzato',el('status-'+c.id).classList.contains('bad')?'bad':'ok');
    }else if(c.frame==='stock'){
      var stockApi=await waitForApi('stock','handleStockDriveSelectChange');
      await stockApi.handleStockDriveSelectChange();
      await syncStatus(c);
    }else{
      var api=await waitForApi('performance',c.handler),setter=api[c.setter]||function(){};
      await api.loadDriveSelectedFile(c.destination,c.selectId,api[c.handler],setter,{force:true});
      await syncStatus(c);
    }
    await syncSelect(c);
  }catch(err){console.error(err);setCardStatus(c,c.title+': '+(err.message||err),'bad');}
}

async function syncSharedDbInfoOnStartup(){
  try{
    var pair=await Promise.all([ensureFrame('performance'),ensureFrame('stock')]);
    var api=await waitForApi('performance','refreshDriveFileList');
    try{await timeout(pair[0].contentWindow.__drivePrimaryReadyPromise||Promise.resolve(),18000,'');}catch(_){ }
    var child=await waitForChildElement('performance',configs.dbinfo.selectId,30000);
    var files=await api.refreshDriveFileList('DBINFO',configs.dbinfo.selectId,api.setDbStatus,{force:false,silent:true});
    await syncSelect(configs.dbinfo);
    var id=child.value||((files&&files[0])?(files[0].id||files[0].fileId):'');
    if(id){el('select-dbinfo').value=id;await handleDriveChoice(configs.dbinfo,id);}
  }catch(err){console.warn('Sincronizzazione DBINFO iniziale non riuscita',err);}
}

function activateMacro(name){
  document.querySelectorAll('.macro-tab').forEach(function(btn){var active=btn.dataset.macro===name;btn.classList.toggle('active',active);btn.setAttribute('aria-selected',active?'true':'false');});
  document.querySelectorAll('.macro-page').forEach(function(page){page.classList.toggle('active',page.id==='macro-'+name);});
  if(name==='performance'||name==='stock')ensureFrame(name).then(function(frame){requestAnimationFrame(function(){try{frame.contentWindow.dispatchEvent(new Event('resize'));}catch(_){ }});}).catch(function(){});
}

document.querySelectorAll('.macro-tab').forEach(function(btn){btn.addEventListener('click',function(){activateMacro(btn.dataset.macro);});});

async function createStoreVisitDashboard(){
  var btn=el('createStoreVisitDashboard'),original=btn?btn.textContent:'';
  if(btn){btn.disabled=true;btn.textContent='CREAZIONE IN CORSO…';}
  try{
    await flushSharedDbInfoToStock();
    var performanceApi=await waitForApi('performance','getStoreVisitKpiPayload');
    var payload=performanceApi.getStoreVisitKpiPayload();
    var stockApi=await waitForApi('stock','createStoreVisitDashboard');
    await stockApi.createStoreVisitDashboard(payload);
  }catch(err){console.error(err);alert('Impossibile creare STORE VISIT DASHBOARD: '+(err&&err.message?err.message:err));}
  finally{if(btn){btn.disabled=false;btn.textContent=original;}}
}
el('createStoreVisitDashboard').addEventListener('click',createStoreVisitDashboard);


function isoWeek(date){var d=new Date(Date.UTC(date.getFullYear(),date.getMonth(),date.getDate()));var day=d.getUTCDay()||7;d.setUTCDate(d.getUTCDate()+4-day);var start=new Date(Date.UTC(d.getUTCFullYear(),0,1));return Math.ceil((((d-start)/86400000)+1)/7);}
function pad2(n){return String(n).padStart(2,'0');}
function weekday(date){return ['Domenica','Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato'][date.getDay()];}
function dateFromValue(value){var d=new Date(value+'T12:00:00');return Number.isNaN(d.getTime())?null:d;}
function driveName(value){var d=dateFromValue(value);if(!d)return '';return String(d.getFullYear()).slice(-2)+pad2(d.getMonth()+1)+pad2(d.getDate())+'_W'+pad2(isoWeek(d))+'_'+weekday(d)+'.xlsx';}
function stockSeasonFromFileName(fileName){var name=String(fileName||'').toUpperCase(),ai=name.indexOf('XIBICM')>=0,pe=name.indexOf('XIBPCM')>=0;return ai&&!pe?'AI':(pe&&!ai?'PE':'');}
function stockName(value,season,original){var d=dateFromValue(value);if(!d||!season)return '';var match=String(original||'').match(/(\.[^.]+)$/);var ext=match?match[1]:'.xlsx';return String(d.getFullYear()).slice(-2)+pad2(d.getMonth()+1)+pad2(d.getDate())+'_W'+pad2(isoWeek(d))+'_'+weekday(d)+'_'+season+ext;}

var modalResolver=null,modalContext=null;
function closeModal(result){var overlay=el('namingModal');overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');var resolve=modalResolver;modalResolver=null;modalContext=null;if(resolve)resolve(result);}
function updateModalPreview(){if(!modalContext)return;var stockMode=modalContext.kind==='stock';if(stockMode&&!modalContext.season){el('modalPreview').textContent='Stagione non riconosciuta nel nome file (atteso XIBICM o XIBPCM).';return;}var value=stockMode?stockName(el('modalDate').value,modalContext.season,modalContext.file.name):driveName(el('modalDate').value);el('modalPreview').textContent=value||'Data non valida';}
function openNamingModal(context){
  if(modalResolver)closeModal(null);
  modalContext=context;
  var now=new Date(),dateValue=now.getFullYear()+'-'+pad2(now.getMonth()+1)+'-'+pad2(now.getDate());
  el('modalDate').value=dateValue;
  var stockMode=context.kind==='stock';
  if(stockMode)modalContext.season=stockSeasonFromFileName(context.file&&context.file.name);
  el('modalSeason').value=stockMode?(modalContext.season||''):'';
  el('modalSeasonField').classList.add('hidden');
  el('modalTitle').textContent=stockMode?'Salvataggio file GIACENZA':(String(context.destination||'').toUpperCase()==='FIDELIZZAZIONE'?'Data salvataggio Fidelizzazione':'Data salvataggio VENDACAP');
  el('modalSubtitle').textContent=stockMode?'A quale giorno si riferisce questo file?':'Seleziona la data da associare al file prima del salvataggio su Drive.';
  updateModalPreview();
  el('namingModal').classList.add('open');el('namingModal').setAttribute('aria-hidden','false');
  setTimeout(function(){el('modalDate').focus();},30);
  return new Promise(function(resolve){modalResolver=resolve;});
}
window.__UNIFIED_REQUEST_DRIVE_NAME=function(destination){return openNamingModal({kind:'drive',destination:destination});};
window.__UNIFIED_REQUEST_STOCK_FILE=async function(file){var name=await openNamingModal({kind:'stock',file:file});return name?new File([file],name,{type:file.type||'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',lastModified:file.lastModified||Date.now()}):null;};

var overwriteResolver=null;
function closeOverwriteModal(result){var overlay=el('overwriteModal');overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');var resolve=overwriteResolver;overwriteResolver=null;if(resolve)resolve(!!result);}
window.__UNIFIED_CONFIRM_STOCK_OVERWRITE=function(){if(overwriteResolver)closeOverwriteModal(false);el('overwriteModal').classList.add('open');el('overwriteModal').setAttribute('aria-hidden','false');setTimeout(function(){el('overwriteProceed').focus();},20);return new Promise(function(resolve){overwriteResolver=resolve;});};
el('overwriteCancel').addEventListener('click',function(){closeOverwriteModal(false);});
el('overwriteProceed').addEventListener('click',function(){closeOverwriteModal(true);});
el('overwriteModal').addEventListener('click',function(e){if(e.target===el('overwriteModal'))closeOverwriteModal(false);});

el('modalDate').addEventListener('input',updateModalPreview);
el('modalSeason').addEventListener('change',updateModalPreview);
el('modalCancel').addEventListener('click',function(){closeModal(null);});
el('modalConfirm').addEventListener('click',function(){if(!modalContext)return;var stockMode=modalContext.kind==='stock';if(stockMode&&!modalContext.season){updateModalPreview();return;}var name=stockMode?stockName(el('modalDate').value,modalContext.season,modalContext.file.name):driveName(el('modalDate').value);if(!name){el('modalPreview').textContent='Seleziona una data valida';return;}closeModal(name);});
el('namingModal').addEventListener('click',function(e){if(e.target===el('namingModal'))closeModal(null);});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&overwriteResolver){closeOverwriteModal(false);return;}if(e.key==='Escape'&&modalResolver)closeModal(null);});

renderCards();
window.__PERFORMANCE_STARTUP_READY__=ensureFrame('performance').then(async function(){
  try{
    var api=await waitForApi('performance','runOrderedDriveStartup',45000);
    await api.runOrderedDriveStartup();
    for(var i=0;i<configList.length;i++){var c=configList[i];if(c.frame==='performance'){await syncSelect(c);await syncStatus(c);}}
    return true;
  }catch(err){console.warn('Avvio ordinato PERFORMANCE non completato',err);return false;}
});
window.__PERFORMANCE_STARTUP_READY__.finally(function(){
  ensureFrame('stock').then(async function(){
    try{
      await flushSharedDbInfoToStock();
      var stockApi=await waitForApi('stock','preloadLatestStockWithPrevious');
      await stockApi.preloadLatestStockWithPrevious();
      await syncSelect(configs.giacenza);
      await syncStatus(configs.giacenza);
    }catch(err){console.warn('Precaricamento GIACENZA iniziale non riuscito',err);}
  }).catch(function(){});
});
})();
</script>
